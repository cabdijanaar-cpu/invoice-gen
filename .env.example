# Supabase PostgreSQL connection strings. Use the transaction pooler for the app.
# Copy both values from Supabase Dashboard > Connect; never commit the real URLs.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Use Supabase direct connection (IPv6) or session pooler for Prisma schema changes.
DIRECT_URL="postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Dedicated disposable Postgres database/project for integration tests only.
# The test runner resets this database. Never point it at production.
TEST_DATABASE_URL=""
TEST_DATABASE_DIRECT_URL=""
TEST_DATABASE_RESET_CONFIRM=""

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
APP_URL="http://localhost:3000"

# Password reset delivery endpoint contract: POST JSON { from, to, subject, text } with Bearer auth.
# Keep these empty until a trusted email delivery endpoint has been configured.
EMAIL_DELIVERY_URL=""
EMAIL_DELIVERY_TOKEN=""
EMAIL_FROM=""

# Supabase Storage: create a private `shop-logos` bucket; copy the project URL and keep the key server-only.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: shared secret for the deployment scheduler calling /api/internal/maintenance/cleanup.
# Generate a distinct random value of at least 32 bytes and keep it in deployment secret storage.
CRON_SECRET=""
