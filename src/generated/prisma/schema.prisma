generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Roles and statuses stay as strings so domain validation remains explicit.
model User {
  id               String                @id @default(cuid())
  email            String                @unique
  name             String
  passwordHash     String
  globalRole       String                @default("USER")
  status           String                @default("ACTIVE")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  memberships      ShopMembership[]
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  createdInvoices  Invoice[]             @relation("InvoiceCreator")
  recordedPayments CustomerPayment[]     @relation("PaymentRecorder")
  recordedExpenses Expense[]             @relation("ExpenseRecorder")
  stockMovements   InventoryMovement[]   @relation("MovementActor")
  auditEvents      AuditLog[]            @relation("AuditActor")
  reviewedSubs     SubscriptionPayment[] @relation("SubscriptionReviewer")
  createdShops     Shop[]                @relation("ShopCreator")

  @@index([status, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthRateLimit {
  id              String   @id @default(cuid())
  key             String
  windowStartedAt DateTime
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([key, windowStartedAt])
  @@index([windowStartedAt])
}

model Shop {
  id            String              @id @default(cuid())
  name          String
  status        String              @default("ACTIVE")
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     User                @relation("ShopCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships   ShopMembership[]
  settings      ShopSettings?
  subscriptions Subscription[]
  customers     Customer[]
  products      Product[]
  movements     InventoryMovement[]
  invoices      Invoice[]
  payments      CustomerPayment[]
  quotations    Quotation[]
  expenses      Expense[]
  auditEvents   AuditLog[]

  @@index([status, createdAt])
}

model ShopMembership {
  id                 String   @id @default(cuid())
  userId             String
  shopId             String
  role               String   @default("CASHIER")
  status             String   @default("ACTIVE")
  // Keep permission overrides explicit and validated in application code.
  canViewReports     Boolean  @default(false)
  canManageProducts  Boolean  @default(false)
  canManageCustomers Boolean  @default(false)
  canManageSettings  Boolean  @default(false)
  canManageUsers     Boolean  @default(false)
  canAdjustInventory Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId, status, role])
}

model ShopSettings {
  id                  String   @id @default(cuid())
  shopId              String   @unique
  legalName           String?
  address             String?
  phone               String?
  email               String?
  website             String?
  taxId               String?
  logoKey             String?
  invoicePrefix       String   @default("INV")
  nextInvoiceNumber   Int      @default(1)
  quotationPrefix     String   @default("QUO")
  nextQuotationNumber Int      @default(1)
  defaultPaymentTerms String?
  defaultTaxRateBps   Int      @default(0)
  defaultDiscountBps  Int      @default(0)
  primaryColor        String   @default("#153d2c")
  footer              String?
  template            String   @default("CLASSIC")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id                  String         @id @default(cuid())
  name                String
  monthlyPriceCents   Int
  yearlyPriceCents    Int
  trialDays           Int            @default(0)
  graceDays           Int            @default(0)
  maxUsers            Int?
  maxProducts         Int?
  maxInvoicesPerMonth Int?
  features            String         @default("")
  status              String         @default("ACTIVE")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
}

model Subscription {
  id        String                @id @default(cuid())
  shopId    String
  planId    String
  status    String                @default("PENDING")
  interval  String                @default("MONTHLY")
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  shop      Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  plan      SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments  SubscriptionPayment[]

  @@index([shopId, status, endsAt])
  @@index([planId, status])
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  amountCents    Int
  currency       String       @default("USD")
  method         String
  reference      String?
  status         String       @default("PENDING")
  submittedAt    DateTime     @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  notes          String?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  reviewedBy     User?        @relation("SubscriptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([subscriptionId, status])
}

model Customer {
  id         String            @id @default(cuid())
  shopId     String
  name       String
  email      String?
  phone      String?
  address    String?
  notes      String?
  status     String            @default("ACTIVE")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  shop       Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  invoices   Invoice[]
  payments   CustomerPayment[]
  quotations Quotation[]

  @@unique([shopId, email])
  @@index([shopId, status, name])
  @@index([shopId, email])
  @@index([shopId, phone])
}

model Product {
  id                     String              @id @default(cuid())
  shopId                 String
  name                   String
  sku                    String?
  barcode                String?
  description            String?
  purchaseCostCents      Int                 @default(0)
  sellingPriceCents      Int
  stockQuantityMilli     Int                 @default(0)
  lowStockThresholdMilli Int                 @default(0)
  unit                   String              @default("item")
  category               String?
  status                 String              @default("ACTIVE")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  shop                   Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  movements              InventoryMovement[]
  invoiceItems           InvoiceItem[]
  quotationItems         QuotationItem[]

  @@unique([shopId, sku])
  @@unique([shopId, barcode])
  @@index([shopId, status, name])
  @@index([shopId, stockQuantityMilli])
}

model InventoryMovement {
  id                 String   @id @default(cuid())
  shopId             String
  productId          String
  actorId            String?
  type               String
  quantityDeltaMilli Int
  reason             String?
  sourceType         String?
  sourceId           String?
  idempotencyKey     String?
  createdAt          DateTime @default(now())
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor              User?    @relation("MovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, productId, createdAt])
  @@index([shopId, sourceType, sourceId])
}

model Invoice {
  id             String            @id @default(cuid())
  shopId         String
  customerId     String?
  createdById    String
  invoiceNumber  String
  idempotencyKey String?
  status         String            @default("DRAFT")
  issuedAt       DateTime?
  dueAt          DateTime?
  currency       String            @default("USD")
  subtotalCents  Int               @default(0)
  discountCents  Int               @default(0)
  taxCents       Int               @default(0)
  totalCents     Int               @default(0)
  notes          String?
  terms          String?
  finalizedAt    DateTime?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy      User              @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items          InvoiceItem[]
  payments       CustomerPayment[]

  @@unique([shopId, invoiceNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, status, issuedAt])
  @@index([shopId, customerId, createdAt])
}

model InvoiceItem {
  id                String   @id @default(cuid())
  invoiceId         String
  position          Int      @default(0)
  productId         String?
  description       String
  skuSnapshot       String?
  quantityMilli     Int
  unitPriceCents    Int
  discountCents     Int      @default(0)
  taxRateBps        Int      @default(0)
  lineTotalCents    Int
  costSnapshotCents Int?
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model CustomerPayment {
  id             String    @id @default(cuid())
  shopId         String
  invoiceId      String
  customerId     String?
  recordedById   String
  amountCents    Int
  currency       String    @default("USD")
  method         String
  reference      String?
  notes          String?
  status         String    @default("POSTED")
  idempotencyKey String?
  paidAt         DateTime  @default(now())
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime  @default(now())
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recordedBy     User      @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, paidAt, status])
  @@index([invoiceId, paidAt])
}

model Quotation {
  id                 String          @id @default(cuid())
  shopId             String
  customerId         String?
  quotationNumber    String
  status             String          @default("DRAFT")
  issuedAt           DateTime        @default(now())
  expiresAt          DateTime?
  currency           String          @default("USD")
  subtotalCents      Int             @default(0)
  discountCents      Int             @default(0)
  taxCents           Int             @default(0)
  totalCents         Int             @default(0)
  convertedInvoiceId String?         @unique
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items              QuotationItem[]

  @@unique([shopId, quotationNumber])
  @@index([shopId, status, expiresAt])
}

model QuotationItem {
  id             String    @id @default(cuid())
  quotationId    String
  position       Int       @default(0)
  productId      String?
  description    String
  skuSnapshot    String?
  quantityMilli  Int
  unitPriceCents Int
  discountCents  Int       @default(0)
  taxRateBps     Int       @default(0)
  lineTotalCents Int
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

model Expense {
  id             String    @id @default(cuid())
  shopId         String
  recordedById   String
  category       String
  description    String
  amountCents    Int
  currency       String    @default("USD")
  method         String?
  reference      String?
  notes          String?
  status         String    @default("POSTED")
  idempotencyKey String?
  reversedAt     DateTime?
  reversalReason String?
  incurredAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  recordedBy     User      @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, incurredAt, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  shopId     String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  requestId  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  shop       Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
